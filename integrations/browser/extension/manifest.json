{
  "manifest_version": 3,
  "name": "灵光 · B站视频转录",
  "version": "0.1.0",
  "description": "在当前B站视频页一键提交本机转录，保留完整文本、字幕和来源。",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "转录当前B站视频"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
